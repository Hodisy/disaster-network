# Private Mac-only bench. Copy to .env.audio-lab; never commit actual values.
# start-audio-lab.py generates the local bridge token when the file is absent.
YAFA_AUDIO_LAB_TOKEN=
# Only needed when explicitly choosing Transcribe with OpenAI. Never sent to Yafa.
OPENAI_API_KEY=
YAFA_TRANSCRIBE_MODEL=gpt-transcribe
# Optional absolute path. Default: ffmpeg in PATH.
YAFA_FFMPEG=

# Actual GPT-Live transport; no silent substitution with Realtime.
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_VOICE=marin

# Optional: conversation-only Responses delegation; no local app harness/tools.
OPENAI_LIVE_BACKEND_MODEL=gpt-5.6-luna
