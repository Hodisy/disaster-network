# Private database and optional Live/maintenance settings, never public frontend configuration.
# Copy to .env and use the EXISTING Aiven PostgreSQL connection details.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/defaultdb
# Absolute or project-relative path to the Aiven CA certificate.
DATABASE_CA_CERT_PATH=

# Private Nitro runtime settings for the optional /settings database reset.
NUXT_DEMO_RESET_ENABLED=false
# Random maintenance key of 32-256 characters. Never put it in public config.
NUXT_DEMO_RESET_TOKEN=
# DATABASE_URL from the Aiven connected service is also supported.
# NUXT_DATABASE_URL=
# NUXT_DATABASE_CA_CERT_PATH=
# Alternatively provide the full CA certificate PEM through a server secret:
# NUXT_DATABASE_CA_CERT=

# Optional GPT-Live hotline. Private server configuration only.
# Permanent project key with GPT-Live AND the delegated model enabled.
OPENAI_API_KEY=
# Explicit opt-in; the default app never opens the microphone automatically.
NUXT_HOTLINE_ENABLED=false
# A separate random 32-256 character demo gate, entered in the hotline UI.
# Never use OPENAI_API_KEY or the database/reset credentials as this value.
NUXT_HOTLINE_ACCESS_TOKEN=
# Must exactly match the browser origin (no trailing slash).
NUXT_HOTLINE_ORIGIN=http://127.0.0.1:3000
# Optional defaults; no silent Realtime fallback.
NUXT_OPENAI_LIVE_MODEL=gpt-live-1
NUXT_OPENAI_BACKEND_MODEL=gpt-6-luna
NUXT_OPENAI_LIVE_VOICE=marin
# Alternative to OPENAI_API_KEY, supported by Nitro private runtime config:
# NUXT_OPENAI_API_KEY=
