  "document_sections": [
    {
      "id": "50000000-0000-4000-8000-000000000001",
      "document_id": "40000000-0000-4000-8000-000000000001",
      "position": 0,
      "title": "Emergency accommodation",
      "clause_reference": "DEMO-ACCOMMODATION",
      "page_start": null,
      "page_end": null,
      "text": "Up to seven nights at EUR 150 per household per night, at most EUR 1,050. Confirm household size, unusability of the main residence, dates and current accommodation need. Extensions require separate review.",
      "language": "en"
    },
    {
      "id": "50000000-0000-4000-8000-000000000002",
      "document_id": "40000000-0000-4000-8000-000000000001",
      "position": 1,
      "title": "Essential items",
      "clause_reference": "DEMO-ESSENTIAL_ITEMS",
      "page_start": null,
      "page_end": null,
      "text": "Up to EUR 250 per household for identified essential expenditure. Confirm need and itemised costs.",
      "language": "en"
    },
    {
      "id": "50000000-0000-4000-8000-000000000003",
      "document_id": "40000000-0000-4000-8000-000000000001",
      "position": 2,
      "title": "Electrical inspection and safety",
      "clause_reference": "DEMO-ELECTRICAL_SAFETY",
      "page_start": null,
      "page_end": null,
      "text": "Up to EUR 500 for assessed electrical inspection and immediate safety work by a qualified professional. Physical work requires permitted access.",
      "language": "en"
    },
    {
      "id": "50000000-0000-4000-8000-000000000004",
      "document_id": "40000000-0000-4000-8000-000000000001",
      "position": 3,
      "title": "Cleaning and drying",
      "clause_reference": "DEMO-CLEANING_DRYING",
      "page_start": null,
      "page_end": null,
      "text": "Up to EUR 3,000 for assessed cleaning and drying. Confirm damage, access, work scope and resource availability.",
      "language": "en"
    },
    {
      "id": "50000000-0000-4000-8000-000000000005",
      "document_id": "40000000-0000-4000-8000-000000000001",
      "position": 4,
      "title": "Moving and temporary storage",
      "clause_reference": "DEMO-MOVING_STORAGE",
      "page_start": null,
      "page_end": null,
      "text": "Up to EUR 1,000 to protect recoverable belongings. Do not count the same belongings as both a total loss and intact stored property.",
      "language": "en"
    },
    {
      "id": "50000000-0000-4000-8000-000000000006",
      "document_id": "40000000-0000-4000-8000-000000000001",
      "position": 5,
      "title": "Damaged contents",
      "clause_reference": "DEMO-CONTENTS",
      "page_start": null,
      "page_end": null,
      "text": "Up to EUR 30,000 for assessed eligible contents damage. Require an inventory, ownership or value evidence and assessment. No automatic new-for-old settlement.",
      "language": "en"
    },
    {
      "id": "50000000-0000-4000-8000-000000000007",
      "document_id": "40000000-0000-4000-8000-000000000001",
      "position": 6,
      "title": "Insured building repairs",
      "clause_reference": "DEMO-BUILDING",
      "page_start": null,
      "page_end": null,
      "text": "Up to EUR 200,000 for assessed eligible damage to the declared owner-occupied main residence. Verify cause and repair scope.",
      "language": "en"
    },
    {
      "id": "50000000-0000-4000-8000-000000000008",
      "document_id": "40000000-0000-4000-8000-000000000001",
      "position": 7,
      "title": "Scope, exclusions and deductible",
      "clause_reference": "DEMO-SCOPE",
      "page_start": null,
      "page_end": null,
      "text": "Fictional product only. Excludes personal injury, vehicles, commercial interruption, undeclared property and unrelated or pre-existing damage. Uncertain causation or ground instability requires human review. One EUR 300 deductible applies to combined eligible contents and building damage per household and event, after limits and eligibility assessment. No demo deductible applies to the five assistance benefits. The contractual flood route does not require a CatNat order; CatNat recognition remains unverified and must not be inferred. No booking, payment or coverage decision is real.",
      "language": "en"
    },
